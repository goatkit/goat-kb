<div class="container mx-auto py-6 max-w-4xl">
	<nav class="flex items-center text-sm mb-4" aria-label="Breadcrumb">
		<a href="/customer/kb" class="gk-link-neon">Knowledge Base</a>
		<svg class="mx-2 h-4 w-4" style="color: var(--gk-text-muted);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
		<span class="font-medium" style="color: var(--gk-text-primary);">Search</span>
	</nav>

	<h1 class="text-2xl font-bold mb-6 gk-heading"><span class="gk-text-gradient">Search Results</span></h1>

	<div class="mb-6">
		<form action="/customer/kb/search" method="GET" class="flex gap-2">
			<input type="text" name="q" value="{{ Query }}" placeholder="Search knowledge base..."
				class="gk-input-neon flex-1" autofocus>
			<button type="submit" class="gk-btn-neon">Search</button>
		</form>
	</div>

	{% if Query == "" %}
	<div class="gk-card-glow">
		<div class="gk-card-body p-12 text-center">
			<svg class="h-12 w-12 mx-auto mb-4" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
			<p class="text-lg font-medium" style="color: var(--gk-text-primary);">Search the knowledge base</p>
			<p class="mt-1 text-sm" style="color: var(--gk-text-muted);">Enter a search term above to find articles.</p>
		</div>
	</div>
	{% elif articles|length == 0 %}
	<div class="gk-card-glow">
		<div class="gk-card-body p-12 text-center">
			<svg class="h-12 w-12 mx-auto mb-4" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
			<p class="text-lg font-medium" style="color: var(--gk-text-primary);">No results found</p>
			<p class="mt-1 text-sm" style="color: var(--gk-text-muted);">No articles matched "{{ Query }}". Try different keywords.</p>
		</div>
	</div>
	{% else %}
	<div class="space-y-3">
	{% for a in articles %}
		<a href="/customer/kb/article/{{ a.ID }}" class="gk-card-glow block hover:opacity-90 transition-opacity">
			<div class="gk-card-body p-4">
				<h3 class="text-md font-semibold gk-link-neon">{{ a.Title }}</h3>
				{% if a.Summary %}
				<p class="text-sm mt-1" style="color: var(--gk-text-muted);">{{ a.Summary }}</p>
				{% endif %}
				<div class="flex items-center gap-3 mt-2 text-xs" style="color: var(--gk-text-muted);">
					<span>{{ a.Category }}</span>
					{% if a.DateStr %}
					<span>{{ a.DateStr }}</span>
					{% endif %}
				</div>
			</div>
		</a>
	{% endfor %}
	</div>
	{% endif %}
</div>